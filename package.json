{
  "name": "betoniera-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "scripts": {
    "build": "npm run clean && npm run generate-icons && npm run generate-licenses && tsc && vite build",
    "clean": "npm run clean-dist && npm run clean-licenses && npm run clean-icons",
    "clean-dist": "rimraf ./dist ./dev-dist",
    "clean-licenses": "rimraf -g ./public/licenses ./public/licenses.*",
    "clean-icons": "rimraf -g ./public/icons/*.ico && rimraf -g ./public/icons/*.png",
    "dev": "vite",
    "format": "prettier --write --ignore-unknown .",
    "generate-icons": "pwa-assets-generator",
    "generate-licenses": "node scripts/generate-licenses.js",
    "install": "npm run generate-icons && npm run generate-licenses",
    "prepare": "npx husky",
    "start": "npm run dev"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.64.1",
    "axios": "^1.9.0",
    "base-64": "^1.0.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^6.23.1",
    "react-router-dom": "^6.23.1"
  },
  "devDependencies": {
    "@types/base-64": "^1.0.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.34.0",
    "@typescript-eslint/parser": "^8.34.0",
    "@vite-pwa/assets-generator": "^1.0.0",
    "@vitejs/plugin-react": "^4.5.2",
    "dotenv": "^16.5.0",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "spdx-expression-parse": "^4.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0"
  }
}
